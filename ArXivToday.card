{
    "name": "ArXivToday",
    "dsl": {
        "config": {
            "update_multi": true
        },
        "i18n_elements": {
            "zh_cn": [
                {
                    "tag": "markdown",
                    "content": "ArXiv Today 小助手来啦٩(๑˃̵ᴗ˂̵๑)۶\n今日找到了**${total_paper}**篇相关论文(..＞◡＜..)",
                    "text_align": "left",
                    "text_size": "normal"
                },
                {
                    "tag": "table",
                    "columns": [
                        {
                            "data_type": "number",
                            "name": "index",
                            "display_name": "序号",
                            "horizontal_align": "center",
                            "width": "auto",
                            "format": {
                                "precision": 0
                            }
                        },
                        {
                            "data_type": "lark_md",
                            "name": "paper",
                            "display_name": "论文",
                            "horizontal_align": "left",
                            "width": "auto"
                        },
                        {
                            "data_type": "text",
                            "name": "published",
                            "display_name": "论文日期",
                            "horizontal_align": "center",
                            "width": "auto"
                        }
                    ],
                    "rows": "${table_rows}",
                    "row_height": "middle",
                    "header_style": {
                        "background_style": "grey",
                        "bold": true,
                        "lines": 1
                    },
                    "page_size": 5
                },
                {
                    "tag": "repeat",
                    "variable": "paper_list",
                    "elements": [
                        {
                            "tag": "markdown",
                            "content": "${paper_list.counter}. Quality: ${paper_list.quality_score}",
                            "text_align": "left",
                            "text_size": "heading",
                            "icon": {
                                "tag": "standard_icon",
                                "token": "describe_outlined",
                                "color": "blue"
                            }
                        },
                        {
                            "tag": "markdown",
                            "content": "${paper_list.evaluation}",
                            "text_align": "left",
                            "text_size": "normal"
                        },
                        {
                            "tag": "hr"
                        }
                    ]
                }
            ]
        },
        "i18n_header": {
            "zh_cn": {
                "title": {
                    "tag": "plain_text",
                    "content": "ArXiv Today"
                },
                "subtitle": {
                    "tag": "plain_text",
                    "content": "${today_date}"
                },
                "text_tag_list": [
                    {
                        "tag": "text_tag",
                        "text": {
                            "tag": "plain_text",
                            "content": "${tag}"
                        },
                        "color": "purple"
                    }
                ],
                "template": "wathet",
                "ud_icon": {
                    "tag": "standard_icon",
                    "token": "send_outlined"
                }
            }
        }
    },
    "variables": [
        {
            "type": "text",
            "apiName": "var_m30b6mn6",
            "name": "today_date",
            "desc": "今日日期",
            "mockData": "2024-10-31"
        },
        {
            "type": "text",
            "apiName": "var_m30b6mof",
            "name": "tag",
            "desc": "论文tag",
            "mockData": "LLM Security"
        },
        {
            "apiName": "variable_vao4f1n5xlj",
            "type": "tableRowArray",
            "name": "table_rows",
            "desc": "表格生成的变量",
            "mockData": [
                {
                    "index": 1,
                    "paper": "**[Paper Title](http://arxiv.org/abs/2411.11451v1)**\n<text_tag color='grey'>arXiv: 2411.11451</text_tag>",
                    "published": "2024-11-02"
                },
                {
                    "index": 2,
                    "paper": "**[Another Paper](http://arxiv.org/abs/2411.10000v1)**\n<text_tag color='grey'>arXiv: 2411.10000</text_tag>",
                    "published": "2024-11-02"
                }
            ]
        },
        {
            "apiName": "variable_btf4sfn5zn6",
            "type": "objectArray",
            "name": "paper_list",
            "desc": "循环容器生成的变量",
            "mockData": [
                {
                    "counter": 1,
                    "quality_score": "86",
                    "evaluation": "该论文提出了具有较高潜在影响的新方法。"
                },
                {
                    "counter": 2,
                    "quality_score": "评估失败",
                    "evaluation": "质量评估失败，仅作为 related 论文展示。"
                },
                {
                    "counter": 3,
                    "quality_score": "",
                    "evaluation": ""
                }
            ],
            "structDescriptions": [
                {
                    "type": "integer",
                    "name": "counter",
                    "desc": "计数器",
                    "apiName": "var_xbszgj43p0q"
                },
                {
                    "type": "text",
                    "name": "quality_score",
                    "desc": "论文质量分数",
                    "apiName": "var_7scnb2qnnj2"
                },
                {
                    "type": "text",
                    "name": "evaluation",
                    "desc": "一句话评价",
                    "apiName": "var_uol2sndj1ea"
                }
            ]
        },
        {
            "type": "integer",
            "apiName": "var_m3164zpl",
            "name": "total_paper",
            "desc": "论文总数",
            "mockData": 7
        }
    ]
}

[Unit]
Description=ArXiv Today daily digest
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3h
StartLimitBurst=4

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/arxiv-today/app
EnvironmentFile=/opt/arxiv-today/app/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/arxiv-today/venv/bin/python /opt/arxiv-today/app/main.py digest
TimeoutStartSec=45min
Restart=on-failure
RestartSec=15min
